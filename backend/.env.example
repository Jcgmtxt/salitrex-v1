ENVIRONMENT="production"

DB_CONNECTION="postgresql"
DB_HOST="db"
DB_PORT=5432
DB_DATABASE="salitrex"
DB_USERNAME="salitrex_user"
DB_PASSWORD="<GENERATE_STRONG_PASSWORD_32_CHARS>"

SECRET_KEY="<GENERATE_64_CHAR_SECRET_KEY>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true

# Hosts que el backend acepta (subdominio API + frontend SPA)
ALLOWED_HOSTS=["api.jcgiraldome.online","salitrex.jcgiraldome.online"]

# Origen del frontend SPA (para CORS cross-subdomain)
CORS_ORIGINS=["https://salitrex.jcgiraldome.online"]

AWS_ACCESS_KEY_ID="<YOUR_AWS_ACCESS_KEY>"
AWS_SECRET_ACCESS_KEY="<YOUR_AWS_SECRET_KEY>"
AWS_REGION="us-east-1"
S3_BUCKET="imagenes-aquashield"
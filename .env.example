# Variables leídas por docker-compose.yml (sustitución ${VAR})
# Cópialo como .env en el VPS y rellena con secrets reales.

# Database
DB_PASSWORD=<GENERATE_STRONG_PASSWORD_32_CHARS>

# JWT
SECRET_KEY=<GENERATE_64_CHAR_SECRET_KEY>

# Hosts y CORS (listas JSON válidas)
ALLOWED_HOSTS=["api.jcgiraldome.online","salitrex.jcgiraldome.online"]
CORS_ORIGINS=["https://salitrex.jcgiraldome.online"]

# AWS S3
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
AWS_REGION=us-east-1
S3_BUCKET=imagenes-aquashield